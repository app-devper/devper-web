# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Vite writes every bundled file under /assets/ with a content hash in its name, so a URL never
# changes meaning: cache it for a year. HTML keeps the Pages default (max-age=0, must-revalidate),
# so a new deploy is picked up on the next load. /favicon.svg is not hashed and keeps the default too.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
